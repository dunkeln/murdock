# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/.nyc_output/

# next.js
/.next/
/out/

# production
/build
/dist

# package manager and build caches
/.cache/
/.turbo/
/.parcel-cache/
/.eslintcache
.npm/
.pnpm-store/

# misc
.DS_Store
*.pem
*.local

# generated logs and diagnostics
logs/
*.log
*.trace
*.prof
*.cpuprofile
*.heapsnapshot

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# deployment provider state
.netlify/
.render/

# typescript
*.tsbuildinfo
next-env.d.ts

# local databases and large binary artifacts
/db/
/database/
/data/
/storage/
*.sqlite
*.sqlite3
*.db
*.db-*
*.dump
*.bak
*.tmp
*.temp
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# local uploads, exports, and generated assets
/uploads/
/exports/
/artifacts/
/examples/
/tmp/
/temp/

# local agent navigation notes
/index.md

# local agent state and memories
/.codex/memories/
/.codex/sessions/
/.codex/logs/
/.agents/
skills-lock.json
